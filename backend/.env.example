# ============================================================
# EngramNote 环境变量配置模板
# ============================================================
# 使用方法：
#   1. 复制本文件为 .env：cp .env.example .env
#   2. 填入你自己的 API 密钥和配置
#   3. .env 文件已被 .gitignore 排除，不会上传到 GitHub
# ============================================================

# ---- AI API 密钥（必填，二选一） ----
# DeepSeek API（生产环境推荐）：https://platform.deepseek.com/ 注册获取
DEEPSEEK_API_KEY=

# 智谱 GLM API（开发调试推荐，有免费额度）：https://open.bigmodel.cn/ 注册获取
GLM_API_KEY=

# ---- JWT 认证密钥 ----
# 生成方法：python -c "import secrets; print(secrets.token_hex(32))"
#
# 分环境行为：
#   APP_ENV=dev （本模板的默认姿态）→ 留空即自动生成随机密钥并持久化到
#                                     data/.jwt-secret，重启复用。**新访客不用填也能跑。**
#   APP_ENV=prod                    → 为空**拒绝启动**（有意的安全姿态）。
#
# ⚠️ 不要填任何"示例值/公开值"：`config.py` 有一张公开占位值黑名单，
#    prod 下命中即拒绝启动，dev 下会被丢弃并换成随机密钥。
JWT_SECRET_KEY=

# ---- 环境与调试开关（阶段 4.10 起三个开关互不影响） ----
# APP_ENV：dev / prod（**代码默认是 prod**；本模板显式写成 dev，
#          这样"复制模板 → 直接启动"就能跑，不用先配密钥）
#   dev  → JWT 可零配置启动、异常会回吐 traceback、开放 /docs
#   prod → 强制配置 JWT_SECRET_KEY、异常只返回统一错误信息、关闭 /docs|/redoc
APP_ENV=dev
#
# LOG_SQL：是否把 SQL 语句打进 data/logs（默认 false）
#   ⚠️ 这些日志包含 bcrypt 哈希与知识卡片/题目的正文，**不要在生产打开**。
#   它以前跟着 DEBUG 一起来，现在必须显式打开 —— 让它是一个有意识的动作。
# LOG_SQL=false
#
# LLM_PROVIDER：auto / deepseek / glm（默认 auto）
#   auto → 开发环境用 GLM（免费）、生产用 DeepSeek（与旧行为一致）
#   显式指定后与环境解耦：在 dev 里用 DeepSeek、在 prod 里用 GLM 都合法
# LLM_PROVIDER=auto
#
# DEBUG：**遗留开关**，等价于 APP_ENV=dev（保留以兼容既有 .env）
#   它不再打开 SQL 日志、也不再决定 LLM 供应商。新部署请用上面三个。
# DEBUG=false

# ---- CORS 跨域来源（可选，逗号分隔） ----
# 默认值：http://localhost:5173,http://localhost:3000（Vite 与 CRA 端口）
# 生产环境改为实际前端域名，如 https://notes.example.com
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- 反向代理与跨域凭据（可选；自托管部署常需要） ----
#
# TRUSTED_PROXIES：可信反向代理的 IP 列表（逗号分隔）。**默认空 = 谁都不信。**
#
#   为什么需要：限流在未认证路径（登录 10/min、注册 5/min）上按客户端 IP 计数，
#   取的是 socket 对端地址 —— 在 nginx / 容器 / 云负载均衡后面，那**永远是
#   反代自己的 IP**，于是全站共用同一个桶：一个脚本就能让所有人无法登录，
#   爆破防护也失去区分度。本项目自带的 frontend/nginx.conf 正是这种部署形态。
#
#   为什么默认空：X-Forwarded-For 是客户端可伪造的头，只有"直连对端确实是
#   本机反代"时才能采信。填上你的反代地址即可启用（只信最右侧那一跳）：
#     示例：TRUSTED_PROXIES=127.0.0.1,172.18.0.1
# TRUSTED_PROXIES=
#
# CORS_ALLOW_CREDENTIALS：跨域时是否允许携带浏览器凭据。**默认 False。**
#
#   本项目认证走 Authorization 头（访问令牌）与请求体（刷新令牌），**不用 Cookie**，
#   因此不需要它；开着只会让"放宽 CORS_ORIGINS"的代价更大。
#   将来若改成 Cookie 会话，必须同时改成 true。

# ---- 应用对外基础 URL（可选） ----
# 用于渲染邮件提醒等场景中的跳转链接，按实际部署域名配置
# APP_BASE_URL=http://localhost:5173

# ---- 文档解析 API（可选，不配置则无法解析 PDF） ----
# Mineru API 令牌：https://mineru.net/ 注册获取
# 配置此项并设置 MINERU_BACKEND=vlm-http-client 后，无需下载本地 MinerU 模型（节省约 7GB）
MINERU_API_TOKEN=

# ---- Mineru 解析后端（可选） ----
# pipeline         使用本地模型（需下载 PDF-Extract-Kit-1.0 + MinerU2.5-Pro，约 7GB）
# vlm-http-client  使用云端 API（推荐，需配置 MINERU_API_TOKEN）
# hybrid-http-client 混合模式
MINERU_BACKEND=vlm-http-client
MINERU_SERVER_URL=https://mineru.net/api/v4/extract/task

# ---- 数据库配置（可选，默认 SQLite 零配置） ----
# 留空则自动使用 data/db/engramnote.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/engramnote

# ---- 文件存储（可选，默认本地文件系统） ----
# STORAGE_BACKEND=local
# STORAGE_DIR=
# Vault 根目录：项目隔离 + 状态旁载结构的根（默认 backend/data/vault）
# 设置后上传文件按 {VAULT_DIR}/{user_id}/{project_slug}/source|output|history|cache 组织
# VAULT_DIR=

# ---- MinIO 对象存储（可选） ----
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET_ORIGINAL=original-files
# MINIO_BUCKET_MARKDOWN=markdown
# MINIO_SECURE=false

# ---- Celery 异步任务（可选，默认文件系统 broker 零依赖） ----
# CELERY_BACKEND=local
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ---- AI 清洗管道（可选，有默认值） ----
# EMBEDDING_MODEL=BAAI/bge-m3
# 内存不足时的降级模型（空闲内存 < EMBEDDING_MIN_FREE_MEMORY_GB 或主模型加载失败时自动切换）
# EMBEDDING_MODEL_FALLBACK=BAAI/bge-small-zh-v1.5
# 低于此空闲内存（GB）时跳过 EMBEDDING_MODEL 直接使用降级模型（bge-m3 建议 4.0）
# EMBEDDING_MIN_FREE_MEMORY_GB=4.0
# EMBEDDING_BATCH_SIZE=16
# SIMILARITY_THRESHOLD=0.92
# CHUNK_SIZE=500
# CHUNK_OVERLAP=50

# ---- LLM 配置 ----
# GLM_MODEL 必须是**生效行**且全小写：智谱 API 要求小写模型名，
# 而 dev 环境（本模板默认姿态，LLM_PROVIDER=auto）走的就是 GLM。
GLM_MODEL=glm-4.7-flash
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MAX_RETRIES=5
# LLM_MAX_RPM=10
#
# 阶段 4.4：限流分三层桶（按用户 / 按供应商 / 总闸门），后两层默认**关闭**。
# 为什么默认关：本项目实际使用人数很少，而"默认收紧"会悄悄改变既有行为
# （例如把单人可用速率砍半）却不给任何提示。多人使用时建议打开，取值约为
# LLM_MAX_RPM 的一半，这样一个人跑理解任务就不会把别人的问答卡住。
# 注意：没有用户上下文的调用共用一个 __anonymous__ 桶，不是免检 ——
# 否则"忘了接上下文"的后台脚本会成为绕过限流的后门。
# LLM_USER_MAX_RPM=5
# LLM_PROVIDER_MAX_RPM=0

# ---- 文件上传限制（可选） ----
# MAX_UPLOAD_SIZE_MB=500
# ALLOWED_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.docx,.pptx,.xlsx,.mp4,.mp3,.wav,.m4a,.md

# ---- ASR 语音转写（可选，需安装 qwen-asr 并下载模型） ----
# ASR 模型路径（空则使用默认 modelscope 缓存路径 ~/.cache/modelscope/hub/models/Qwen/Qwen3-ASR-0___6B）
# 运行 python check_env.py --download-asr 自动下载
ASR_MODEL_PATH=
# ASR 转写语言（空字符串为自动检测，"Chinese" 强制中文）
ASR_LANGUAGE=Chinese
# ASR 是否启用标点恢复
ASR_ENABLE_PUNCTUATION=true
# ASR 是否启用标题生成
ASR_ENABLE_TITLE_GENERATION=true
# ASR 缓存目录（空则使用默认 ~/.cache/asr_converter）
ASR_CACHE_DIR=

# ---- Silero VAD 模型（可选，ASR 语音活动检测用） ----
# 模型本地目录（空则使用 data/models/silero-vad/，运行 check_env.py --fix 自动下载）
VAD_MODEL_DIR=

# ---- 日志级别（可选） ----
# LOG_LEVEL=INFO

# ---- 调试开关（遗留：`DEBUG` 现在等价于 `APP_ENV=dev`） ----
# ⚠️ 本模板**不再提供激活的 `DEBUG`**。它曾是唯一的开关，4.10 之后只剩一个作用：
#    DEBUG=true 等价于 APP_ENV=dev（保留这一条是为了让既有 .env 继续可用）。
#    它**不再**打开 SQL 日志、也**不再**决定 LLM 供应商 —— 因此下面这句旧说明
#    已经失效，不要照着它配："DEBUG=true 时使用 GLM，DEBUG=false 时使用 DeepSeek"
#    （供应商由 LLM_PROVIDER 决定，只有 auto 时才跟随环境）。
#
# 三个开关及其**真实默认值**（本模板不激活任何一项 = 与 app/config.py 一致）：
#    APP_ENV=prod        开发姿态请显式写成 dev（JWT 可零配置、traceback 可见）
#    LOG_SQL=false       这些日志含 bcrypt 哈希与卡片/题目正文，开发时才显式打开
#    LLM_PROVIDER=auto   auto → dev 用 GLM、prod 用 DeepSeek；也可显式指定
# 用法与取值细节见上面的「环境与调试开关（可选；阶段 4.10 起三个开关互不影响）」一节，
# 那里也是唯一权威的说明。需要开发环境时请用 APP_ENV，不要用 DEBUG。
# （`DEBUG` 的登记行见那一节末尾，此处不再重复 —— 同名变量写两遍会让
#   "哪个值生效"取决于行序，也会让 --append 来回改文件。）

# ---- SMTP 邮件配置（可选，配置后用于复习提醒邮件） ----
# SMTP 服务器地址（如 smtp.qq.com、smtp.gmail.com），留空则禁用邮件提醒
SMTP_HOST=
# SMTP 服务器端口（587 为 STARTTLS 常用端口，465 为 SSL 常用端口）
SMTP_PORT=587
# SMTP 登录用户名（通常为邮箱地址）
SMTP_USER=
# SMTP 登录密码（部分邮箱需使用授权码而非登录密码）
SMTP_PASSWORD=
# 发件人邮箱地址（留空时使用 SMTP_USER）
SMTP_FROM=
# 是否启用 STARTTLS 加密传输
SMTP_USE_TLS=true

# ---- 复习提醒配置（可选） ----
# 提醒轮询间隔（秒），Celery 定时任务扫描到期复习的频率
REMINDER_POLL_INTERVAL_SECONDS=600
# 免打扰时段开始时间（24 小时制，22 表示 22:00 之后不发送提醒）
REMINDER_QUIET_HOURS_START=22
# 免打扰时段结束时间（24 小时制，8 表示 08:00 之后恢复发送提醒）
REMINDER_QUIET_HOURS_END=8
# 是否启用邮件复习提醒
EMAIL_REMINDER_ENABLED=false
# 每日邮件提醒发送时间（24 小时制，9 表示每天 09:00 发送）
EMAIL_REMINDER_HOUR=9

# ---- 由 scripts/gen_env_example.py 补齐的配置项（阶段 2.3）----
# 这些字段此前只在 app/config.py 里存在，模板未登记 —— 访客因此看不出
# 系统有配额、有调度器切换、有备份保留策略。默认值即代码默认值。

# ---- JWT 令牌 ----
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=1440

# REFRESH_TOKEN_EXPIRE_DAYS=30
# BCRYPT_ROUNDS=12
# MAX_PDF_PAGES=2000
# MAX_ARCHIVE_UNCOMPRESSED_MB=500
# MAX_ARCHIVE_COMPRESSION_RATIO=100
# MAX_ARCHIVE_ENTRIES=5000
# MAX_NOTES_PER_USER=5000
# VECTOR_SIMILARITY_FLOOR=0.35
# CARD_MIN_CONTENT_CHARS=10
# CARD_MIN_TITLE_CHARS=2
# CARD_REQUIRE_SOURCE_TEXT=True
# CARD_MAX_NEW_PER_RUN=500
# DAILY_REVIEW_LIMIT=10
# STORAGE_BACKUP_KEEP=3

# ---- 配额与限额 ----
# MAX_STORAGE_PER_USER_MB=5000

# ---- 检索融合（RRF 与候选池） ----
# RAG_RRF_K=1
# RAG_RRF_BM25_WEIGHT=0.65
# RAG_CANDIDATE_POOL=20

# ---- LLM 调用治理（重试 / 限额 / 缓存 / 计价） ----
# LLM_RETRY_DELAY=1.0
# LLM_TIMEOUT_SECONDS=600.0
# LLM_JSON_MAX_TOKENS=16384
# LLM_JSON_MAX_TOKENS_CEILING=32768
# LLM_PRICE_INPUT_PER_1M=0.0
# LLM_PRICE_OUTPUT_PER_1M=0.0
# LLM_PRICE_CURRENCY=CNY
# LLM_CALL_RETENTION_DAYS=365
# LLM_DAILY_TOKEN_QUOTA=0
# LLM_DAILY_COST_QUOTA=0.0
# LLM_CACHE_ENABLED=True
# LLM_CACHE_TTL_DAYS=30

# ---- 复习调度（每日上限 / 到期时刻 / fuzz） ----
# REVIEW_SCHEDULER=fsrs
# REVIEW_FUZZ_RATIO=0.05
# REVIEW_DUE_HOUR=4

# ---- 调度算法（FSRS） ----
# FSRS_REQUEST_RETENTION=0.9
# FSRS_MAX_INTERVAL_DAYS=3650

# ---- 备份保留 ----
# BACKUP_KEEP=14

# ---- 日志 ----
# LOG_DIR=
# LOG_MAX_BYTES=10 * 1024 * 1024  # 10MB
# LOG_BACKUP_COUNT=30


# ---- 由 scripts/gen_env_example.py 补齐的配置项（阶段 2.3）----
# 这些字段此前只在 app/config.py 里存在，模板未登记 —— 访客因此看不出
# 系统有配额、有调度器切换、有备份保留策略。默认值即代码默认值。

# ---- 其他配置 ----
# CORS_ALLOW_CREDENTIALS=False


# ---- 由 scripts/gen_env_example.py 补齐的配置项（阶段 2.3）----
# 这些字段此前只在 app/config.py 里存在，模板未登记 —— 访客因此看不出
# 系统有配额、有调度器切换、有备份保留策略。默认值即代码默认值。

# ---- 其他配置 ----

