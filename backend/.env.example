# ============================================================
# EngramNote 环境变量配置模板
# ============================================================
# 使用方法：
#   1. 复制本文件为 .env：cp .env.example .env
#   2. 填入你自己的 API 密钥和配置
#   3. .env 文件已被 .gitignore 排除，不会上传到 GitHub
# ============================================================

# ---- AI API 密钥（必填，二选一） ----
# DeepSeek API（生产环境推荐）：https://platform.deepseek.com/ 注册获取
DEEPSEEK_API_KEY=

# 智谱 GLM API（开发调试推荐，有免费额度）：https://open.bigmodel.cn/ 注册获取
GLM_API_KEY=

# ---- JWT 认证密钥（生产环境必填） ----
# 生成方法：python -c "import secrets; print(secrets.token_hex(32))"
# 开发环境（APP_ENV=dev）留空时自动生成随机密钥并持久化到 data/.jwt-secret（重启复用）；
# 生产环境（APP_ENV=prod）为空将拒绝启动
JWT_SECRET_KEY=

# ---- 环境与调试开关（可选；阶段 4.10 起三个开关互不影响） ----
# APP_ENV：dev / prod（默认 prod）
#   dev  → JWT 可零配置启动、异常会回吐 traceback
#   prod → 异常只返回统一错误信息
# APP_ENV=prod
#
# LOG_SQL：是否把 SQL 语句打进 data/logs（默认 false）
#   ⚠️ 这些日志包含 bcrypt 哈希与知识卡片/题目的正文，**不要在生产打开**。
#   它以前跟着 DEBUG 一起来，现在必须显式打开 —— 让它是一个有意识的动作。
# LOG_SQL=false
#
# LLM_PROVIDER：auto / deepseek / glm（默认 auto）
#   auto → 开发环境用 GLM（免费）、生产用 DeepSeek（与旧行为一致）
#   显式指定后与环境解耦：在 dev 里用 DeepSeek、在 prod 里用 GLM 都合法
# LLM_PROVIDER=auto
#
# DEBUG：**遗留开关**，等价于 APP_ENV=dev（保留以兼容既有 .env）
#   它不再打开 SQL 日志、也不再决定 LLM 供应商。新部署请用上面三个。
# DEBUG=false

# ---- CORS 跨域来源（可选，逗号分隔） ----
# 默认值：http://localhost:5173,http://localhost:3000（Vite 与 CRA 端口）
# 生产环境改为实际前端域名，如 https://notes.example.com
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- 应用对外基础 URL（可选） ----
# 用于渲染邮件提醒等场景中的跳转链接，按实际部署域名配置
# APP_BASE_URL=http://localhost:5173

# ---- 文档解析 API（可选，不配置则无法解析 PDF） ----
# Mineru API 令牌：https://mineru.net/ 注册获取
# 配置此项并设置 MINERU_BACKEND=vlm-http-client 后，无需下载本地 MinerU 模型（节省约 7GB）
MINERU_API_TOKEN=

# ---- Mineru 解析后端（可选） ----
# pipeline         使用本地模型（需下载 PDF-Extract-Kit-1.0 + MinerU2.5-Pro，约 7GB）
# vlm-http-client  使用云端 API（推荐，需配置 MINERU_API_TOKEN）
# hybrid-http-client 混合模式
MINERU_BACKEND=vlm-http-client
MINERU_SERVER_URL=https://mineru.net/api/v4/extract/task

# ---- 数据库配置（可选，默认 SQLite 零配置） ----
# 留空则自动使用 data/db/engramnote.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/engramnote

# ---- 文件存储（可选，默认本地文件系统） ----
# STORAGE_BACKEND=local
# STORAGE_DIR=
# Vault 根目录：项目隔离 + 状态旁载结构的根（默认 backend/data/vault）
# 设置后上传文件按 {VAULT_DIR}/{user_id}/{project_slug}/source|output|history|cache 组织
# VAULT_DIR=

# ---- MinIO 对象存储（可选） ----
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET_ORIGINAL=original-files
# MINIO_BUCKET_MARKDOWN=markdown
# MINIO_SECURE=false

# ---- Celery 异步任务（可选，默认文件系统 broker 零依赖） ----
# CELERY_BACKEND=local
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ---- AI 清洗管道（可选，有默认值） ----
# EMBEDDING_MODEL=BAAI/bge-m3
# 内存不足时的降级模型（空闲内存 < EMBEDDING_MIN_FREE_MEMORY_GB 或主模型加载失败时自动切换）
# EMBEDDING_MODEL_FALLBACK=BAAI/bge-small-zh-v1.5
# 低于此空闲内存（GB）时跳过 EMBEDDING_MODEL 直接使用降级模型（bge-m3 建议 4.0）
# EMBEDDING_MIN_FREE_MEMORY_GB=4.0
# EMBEDDING_BATCH_SIZE=16
# SIMILARITY_THRESHOLD=0.92
# CHUNK_SIZE=500
# CHUNK_OVERLAP=50

# ---- LLM 配置（可选，有默认值） ----
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# GLM_MODEL=glm-4.7-flash
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MAX_RETRIES=5
# LLM_MAX_RPM=10
#
# 阶段 4.4：限流分三层桶（按用户 / 按供应商 / 总闸门），后两层默认**关闭**。
# 为什么默认关：本项目实际使用人数很少，而"默认收紧"会悄悄改变既有行为
# （例如把单人可用速率砍半）却不给任何提示。多人使用时建议打开，取值约为
# LLM_MAX_RPM 的一半，这样一个人跑理解任务就不会把别人的问答卡住。
# 注意：没有用户上下文的调用共用一个 __anonymous__ 桶，不是免检 ——
# 否则"忘了接上下文"的后台脚本会成为绕过限流的后门。
# LLM_USER_MAX_RPM=5
# LLM_PROVIDER_MAX_RPM=0

# ---- 文件上传限制（可选） ----
# MAX_UPLOAD_SIZE_MB=500
# ALLOWED_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.docx,.pptx,.xlsx,.mp4,.mp3,.wav,.m4a,.md

# ---- ASR 语音转写（可选，需安装 qwen-asr 并下载模型） ----
# ASR 模型路径（空则使用默认 modelscope 缓存路径 ~/.cache/modelscope/hub/models/Qwen/Qwen3-ASR-0___6B）
# 运行 python check_env.py --download-asr 自动下载
ASR_MODEL_PATH=
# ASR 转写语言（空字符串为自动检测，"Chinese" 强制中文）
ASR_LANGUAGE=Chinese
# ASR 是否启用标点恢复
ASR_ENABLE_PUNCTUATION=true
# ASR 是否启用标题生成
ASR_ENABLE_TITLE_GENERATION=true
# ASR 缓存目录（空则使用默认 ~/.cache/asr_converter）
ASR_CACHE_DIR=

# ---- Silero VAD 模型（可选，ASR 语音活动检测用） ----
# 模型本地目录（空则使用 data/models/silero-vad/，运行 check_env.py --fix 自动下载）
VAD_MODEL_DIR=

# ---- 日志级别（可选） ----
# LOG_LEVEL=INFO

# ---- 调试开关（遗留：`DEBUG` 现在等价于 `APP_ENV=dev`） ----
# ⚠️ 本模板**不再提供激活的 `DEBUG`**。它曾是唯一的开关，4.10 之后只剩一个作用：
#    DEBUG=true 等价于 APP_ENV=dev（保留这一条是为了让既有 .env 继续可用）。
#    它**不再**打开 SQL 日志、也**不再**决定 LLM 供应商 —— 因此下面这句旧说明
#    已经失效，不要照着它配："DEBUG=true 时使用 GLM，DEBUG=false 时使用 DeepSeek"
#    （供应商由 LLM_PROVIDER 决定，只有 auto 时才跟随环境）。
#
# 三个开关及其**真实默认值**（本模板不激活任何一项 = 与 app/config.py 一致）：
#    APP_ENV=prod        开发姿态请显式写成 dev（JWT 可零配置、traceback 可见）
#    LOG_SQL=false       这些日志含 bcrypt 哈希与卡片/题目正文，开发时才显式打开
#    LLM_PROVIDER=auto   auto → dev 用 GLM、prod 用 DeepSeek；也可显式指定
# 用法与取值细节见上面的「环境与调试开关（可选；阶段 4.10 起三个开关互不影响）」一节，
# 那里也是唯一权威的说明。需要开发环境时请用 APP_ENV，不要用 DEBUG。
# DEBUG=false

# ---- SMTP 邮件配置（可选，配置后用于复习提醒邮件） ----
# SMTP 服务器地址（如 smtp.qq.com、smtp.gmail.com），留空则禁用邮件提醒
SMTP_HOST=
# SMTP 服务器端口（587 为 STARTTLS 常用端口，465 为 SSL 常用端口）
SMTP_PORT=587
# SMTP 登录用户名（通常为邮箱地址）
SMTP_USER=
# SMTP 登录密码（部分邮箱需使用授权码而非登录密码）
SMTP_PASSWORD=
# 发件人邮箱地址（留空时使用 SMTP_USER）
SMTP_FROM=
# 是否启用 STARTTLS 加密传输
SMTP_USE_TLS=true

# ---- 复习提醒配置（可选） ----
# 提醒轮询间隔（秒），Celery 定时任务扫描到期复习的频率
REMINDER_POLL_INTERVAL_SECONDS=600
# 免打扰时段开始时间（24 小时制，22 表示 22:00 之后不发送提醒）
REMINDER_QUIET_HOURS_START=22
# 免打扰时段结束时间（24 小时制，8 表示 08:00 之后恢复发送提醒）
REMINDER_QUIET_HOURS_END=8
# 是否启用邮件复习提醒
EMAIL_REMINDER_ENABLED=false
# 每日邮件提醒发送时间（24 小时制，9 表示每天 09:00 发送）
EMAIL_REMINDER_HOUR=9
