{
  "name": "engramnote-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "EngramNote 前端（React + TypeScript + Vite）：资料清洗对比、知识图谱、复习与问答界面",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trx-0833/EngramNote.git",
    "directory": "frontend"
  },
  "homepage": "https://github.com/trx-0833/EngramNote#readme",
  "bugs": {
    "url": "https://github.com/trx-0833/EngramNote/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src/ e2e/ scripts/",
    "lint:fix": "eslint src/ e2e/ scripts/ --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --project=chromium",
    "e2e:headed": "playwright test --project=chromium --headed",
    "e2e:all": "playwright test",
    "e2e:full": "playwright test --project=e2e-full",
    "e2e:full:headed": "playwright test --project=e2e-full --headed",
    "e2e:full:probe": "playwright test --project=e2e-full-probe",
    "a11y": "playwright test --project=a11y",
    "a11y:headed": "playwright test --project=a11y --workers=1 --headed",
    "shots": "playwright test --project=shots",
    "format": "prettier --write src/ e2e/ scripts/",
    "format:check": "prettier --check src/ e2e/ scripts/",
    "gen:api": "openapi-typescript ../backend/openapi.json -o src/api/generated/schema.ts && prettier --write src/api/generated/schema.ts",
    "gen:api:drift": "node src/api/generated/openapi-drift.mjs",
    "gen:api:drift:delta": "node scripts/drift-delta.mjs",
    "docs:tables": "node scripts/doc-table-scan.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.15",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.7",
    "marked": "^18.0.13",
    "marked-highlight": "^2.2.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-force-graph-2d": "^1.29.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/katex": "^0.16.8",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.8",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
