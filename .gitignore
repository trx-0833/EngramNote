# ============================================================
# EngramNote .gitignore
# ============================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
.eggs/

# ---- 虚拟环境 ----
venv/
.venv/
env/
mineru_env/

# ---- 环境变量与敏感信息（绝不提交） ----
.env
.env.local
.env.*.local
*.env
!.env.example

# ---- 运行时数据（用户生成，不提交） ----
backend/data/db/
backend/data/storage/
backend/data/celery/
backend/data/chroma/
backend/data/logs/
backend/data/models/
backend/data/

# ---- 用户学习资料与笔记（隐私内容，不提交） ----
resource/
notes/

# ---- 参赛截图与临时文件 ----
参赛提交图片/
参赛作品.html
参赛贴文.md
EngranmNote--Demo.html

# ---- 辅助文档（与项目功能无直接关联） ----
GitHub上传教程.md
UX_AUDIT_REPORT.md
code_review_report.md
未完成的内容.md

# ---- 临时测试脚本（backend 根目录下的零散测试文件） ----
backend/test.py
backend/test_api.py
backend/test_*.py
backend/verify_*.py
backend/reset_*.py
backend/restore_*.py

# ---- 运维脚本中含真实用户数据的文件（隐私，不提交） ----
backend/scripts/cleanup_test_data.py

# ---- 测试与缓存 ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# ---- Node.js ----
node_modules/
frontend/dist/
frontend/.vite/

# ---- IDE ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- 操作系统 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Trae AI 工作文件 ----
.trae/

# ---- 日志 ----
*.log

# ---- 数据库文件 ----
*.db
*.sqlite3
*.db-journal

# ---- 模型缓存 ----
*.bin
*.safetensors
*.pt
*.pth
*.onnx
